#ifndef LUA_H
#define LUA_H

#define LUA_VERSION_MAJOR	"5"
#define LUA_VERSION_MINOR	"4"
#define LUA_VERSION_NUM		504
#define LUA_OK		0

typedef struct lua_State lua_State;

typedef int (*lua_CFunction) (lua_State *L);

#define LUA_REGISTRYINDEX	(-1000000)
#define lua_upvalueindex(i)	(LUA_REGISTRYINDEX - (i))

#ifdef __cplusplus
extern "C" {
#endif

lua_State *(luaL_newstate) (void);
void (lua_close) (lua_State *L);
int (lua_pcallk) (lua_State *L, int nargs, int nresults, int errfunc, int ctx, lua_CFunction k);
#define lua_pcall(L,n,r,e)	lua_pcallk(L, (n), (r), (e), 0, NULL)

const char *(lua_tolstring) (lua_State *L, int idx, size_t *len);
#define lua_tostring(L,i)	lua_tolstring(L, (i), NULL)

void (lua_settop) (lua_State *L, int idx);
#define lua_pop(L,n)		lua_settop(L, -(n)-1)

int (lua_type) (lua_State *L, int idx);
#define lua_isfunction(L,n)	(lua_type(L,(n)) == 6)

void (lua_rawgeti) (lua_State *L, int idx, long long n);
void (lua_pushcclosure) (lua_State *L, lua_CFunction fn, int n);
#define lua_register(L,n,f) (lua_pushcclosure(L, (f), 0), lua_setglobal(L, (n)))
void (lua_setglobal) (lua_State *L, const char *name);
void (lua_getglobal) (lua_State *L, const char *name);

#ifdef __cplusplus
}
#endif

#endif
