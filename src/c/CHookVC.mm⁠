#import "CHookVC.h"
#import "ToolTheme.h"

@interface CHookVC ()
@property (nonatomic, strong) UIScrollView *scrollView;
@property (nonatomic, strong) UITextView *codeTextView;
@property (nonatomic, strong) UIButton *copyButton;
@property (nonatomic, strong) UISegmentedControl *templateSelector;
@end

@implementation CHookVC

- (void)viewDidLoad {
    [super viewDidLoad];
    self.view.backgroundColor = [ToolTheme shared].background;
    [self setupUI];
}

- (void)setupUI {
    CGFloat w = CGRectGetWidth(self.view.bounds);
    CGFloat h = CGRectGetHeight(self.view.bounds);
    if (w <= 50) w = 450;
    if (h <= 50) h = 300;

    self.scrollView = [[UIScrollView alloc] initWithFrame:CGRectMake(0, 0, w, h)];
    self.scrollView.backgroundColor = [UIColor clearColor];
    self.scrollView.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
    [self.view addSubview:self.scrollView];

    CGFloat pad = 12;
    CGFloat y = 12;
    CGFloat availableW = w - (pad * 2);

    UILabel *titleLbl = [[UILabel alloc] initWithFrame:CGRectMake(pad, y, availableW, 20)];
    titleLbl.text = @"[ C++ HOOK TEMPLATES & EXPLOITS ]";
    titleLbl.textColor = [ToolTheme shared].accent;
    titleLbl.font = [[ToolTheme shared] monoBoldFont:11];
    [self.scrollView addSubview:titleLbl];
    y += 28;

    NSArray *items = @[@"Position / ESP", @"Health / HP", @"Bypass Check", @"List<T> Parse"];
    self.templateSelector = [[UISegmentedControl alloc] initWithItems:items];
    self.templateSelector.frame = CGRectMake(pad, y, availableW, 30);
    self.templateSelector.selectedSegmentIndex = 0;
    self.templateSelector.backgroundColor = [ToolTheme shared].surface;
    self.templateSelector.selectedSegmentTintColor = [ToolTheme shared].accent;
    [self.templateSelector setTitleTextAttributes:@{NSForegroundColorAttributeName: [ToolTheme shared].textPrimary, NSFontAttributeName: [[ToolTheme shared] monoBoldFont:10]} forState:UIControlStateNormal];
    [self.templateSelector setTitleTextAttributes:@{NSForegroundColorAttributeName: [UIColor blackColor], NSFontAttributeName: [[ToolTheme shared] monoBoldFont:10]} forState:UIControlStateSelected];
    [self.templateSelector addTarget:self action:@selector(templateChanged:) forControlEvents:UIControlEventValueChanged];
    [self.scrollView addSubview:self.templateSelector];
    y += 42;

    CGFloat editorH = h - y - 70;
    if (editorH < 120) editorH = 120;

    self.codeTextView = [[UITextView alloc] initWithFrame:CGRectMake(pad, y, availableW, editorH)];
    self.codeTextView.backgroundColor = [ToolTheme shared].surface;
    self.codeTextView.textColor = [UIColor colorWithRed:0.00 green:0.90 blue:0.46 alpha:1.0];
    self.codeTextView.font = [[ToolTheme shared] monoFont:11];
    self.codeTextView.editable = NO;
    self.codeTextView.layer.cornerRadius = 6;
    self.codeTextView.layer.borderWidth = 1;
    self.codeTextView.layer.borderColor = [ToolTheme shared].border.CGColor;
    self.codeTextView.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
    [self.scrollView addSubview:self.codeTextView];

    [self updateCodeTemplateForIndex:0];
    y += editorH + 12;

    self.copyButton = [UIButton buttonWithType:UIButtonTypeSystem];
    self.copyButton.frame = CGRectMake(pad, y, availableW, 38);
    self.copyButton.backgroundColor = [ToolTheme shared].accent;
    [self.copyButton setTitle:@"📋 COPY C++ CODE TO CLIPBOARD" forState:UIControlStateNormal];
    [self.copyButton setTitleColor:[UIColor blackColor] forState:UIControlStateNormal];
    self.copyButton.titleLabel.font = [[ToolTheme shared] monoBoldFont:11];
    self.copyButton.layer.cornerRadius = 6;
    self.copyButton.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleTopMargin;
    [self.copyButton addTarget:self action:@selector(didTapCopy) forControlEvents:UIControlEventTouchUpInside];
    [self.scrollView addSubview:self.copyButton];

    self.scrollView.contentSize = CGSizeMake(w, y + 60);
}

- (void)templateChanged:(UISegmentedControl *)sender {
    [self updateCodeTemplateForIndex:sender.selectedSegmentIndex];
}

- (void)updateCodeTemplateForIndex:(NSInteger)index {
    switch (index) {
        case 0:
            self.codeTextView.text = @"#include <substrate.h>\n\n// Hook get_Position cho Unity IL2CPP\nVector3 (*old_get_Position)(void *instance);\nVector3 hk_get_Position(void *instance) {\n    if (!instance) return old_get_Position(instance);\n    Vector3 pos = old_get_Position(instance);\n    // Tùy chỉnh override tọa độ tại đây\n    return pos;\n}\n\nvoid initPositionHook() {\n    void *addr = (void *)((uintptr_t)_dyld_get_image_header(0) + 0x1A2B3C);\n    MSHookFunction(addr, (void *)hk_get_Position, (void **)&old_get_Position);\n}";
            break;
        case 1:
            self.codeTextView.text = @"#include <substrate.h>\n\n// Hook get_Hp / Health\nfloat (*old_get_Hp)(void *instance);\nfloat hk_get_Hp(void *instance) {\n    if (!instance) return 0.0f;\n    // Khóa máu / God Mode\n    return 9999.0f;\n}\n\nvoid initHpHook() {\n    void *addr = (void *)((uintptr_t)_dyld_get_image_header(0) + 0x2B3C4D);\n    MSHookFunction(addr, (void *)hk_get_Hp, (void **)&old_get_Hp);\n}";
            break;
        case 2:
            self.codeTextView.text = @"#include <substrate.h>\n\n// Bypass Check / Integrity\nbool (*old_CheckSignature)(void *self);\nbool hk_CheckSignature(void *self) {\n    // Luôn trả về true để bypass kiểm tra chữ ký\n    return true;\n}\n\nvoid initBypass() {\n    void *addr = (void *)((uintptr_t)_dyld_get_image_header(0) + 0x3C4D5E);\n    MSHookFunction(addr, (void *)hk_CheckSignature, (void **)&old_CheckSignature);\n}";
            break;
        case 3:
            self.codeTextView.text = @"#include <stdint.h>\n\n// Parse C# List<T> trong IL2CPP Heap\ntypedef struct Il2CppArraySize {\n    void *klass;\n    void *monitor;\n    void *bounds;\n    int32_t max_length;\n    void *vector[1];\n} Il2CppArraySize;\n\nvoid* parseList(void *listPtr) {\n    if (!listPtr) return nullptr;\n    // Lấy items array từ offset List<T>\n    void *items = *(void **)((char *)listPtr + 0x10);\n    return items;\n}";
            break;
        default:
            self.codeTextView.text = @"// Chọn template phía trên";
            break;
    }
}

- (void)didTapCopy {
    NSString *code = self.codeTextView.text;
    if (code.length == 0) return;

    UIPasteboard *pasteboard = [UIPasteboard generalPasteboard];
    pasteboard.string = code;

    UIAlertController *alert = [UIAlertController alertControllerWithTitle:@"✅ Thành công!" message:@"Đã copy toàn bộ mã nguồn C++ Hook vào Clipboard." preferredStyle:UIAlertControllerStyleAlert];
    [alert addAction:[UIAlertAction actionWithTitle:@"OK" style:UIAlertActionStyleDefault handler:nil]];
    [self presentViewController:alert animated:YES completion:nil];
}

- (void)reload {
    if ([self isViewLoaded]) {}
}

@end
